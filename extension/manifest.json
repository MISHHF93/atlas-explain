{
  "manifest_version": 3,
  "name": "ATLAS Explain",
  "version": "0.1.0",
  "description": "Educational explanations of trading terms and market moves. Not investment advice.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ATLAS Explain",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "optional_permissions": ["sidePanel"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open ATLAS Explain"
    }
  }
}
