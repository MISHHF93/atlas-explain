{
  "name": "atlas-explain",
  "version": "0.1.0",
  "description": "Market jargon in plain language: an MCP connector for AI assistants and a web app with Firebase AI Logic hybrid inference. Education only, not financial advice.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "deploy:mcp": "wrangler deploy",
    "data:capture": "node scripts/data/build-data.ts",
    "data:publish": "node scripts/data/build-data.ts --upload",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "remote-config": "node scripts/emit-remote-config.mjs",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "check:trade-words": "node scripts/trade-word-scan.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test:rules": "npx --yes firebase-tools@15.36.0 emulators:exec --only firestore --project demo-atlas-explain \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^13.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "4.167.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "minimatch": "^11.0.1"
  }
}
