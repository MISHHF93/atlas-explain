{
  "name": "atlas-explain",
  "version": "0.1.0",
  "description": "Educational explanations of market moves using Firebase AI Logic hybrid inference. Not financial advice.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:extension": "vite build --config vite.extension.config.ts && node scripts/zip-extension.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "remote-config": "node scripts/emit-remote-config.mjs"
  },
  "dependencies": {
    "firebase": "^13.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "minimatch": "^11.0.1"
  }
}
