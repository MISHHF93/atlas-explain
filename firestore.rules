rules_version = '2';

// Each user (anonymous or signed in) can read and write only their own documents.
// Private notes and watchlists are rejected so they are not stored in the cloud.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/usage/{dayId} {
      allow read: if signedIn(userId);
      allow delete: if false;

      // First cloud call of the UTC day creates the counter at 1.
      allow create: if signedIn(userId)
        && isUsageDay(dayId)
        && request.resource.data.keys().hasOnly(["cloudCalls", "date"])
        && request.resource.data.date == dayId
        && request.resource.data.cloudCalls is int
        && request.resource.data.cloudCalls == 1;

      // Later calls may add exactly one. No other field can change.
      allow update: if signedIn(userId)
        && isUsageDay(dayId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["cloudCalls"])
        && request.resource.data.date == resource.data.date
        && request.resource.data.date == dayId
        && request.resource.data.cloudCalls is int
        && resource.data.cloudCalls is int
        && request.resource.data.cloudCalls == resource.data.cloudCalls + 1;
    }

    // Preferences for a signed-in account. Only the theme is stored; nothing private.
    match /users/{userId}/prefs/{prefId} {
      allow read: if signedIn(userId);
      allow delete: if signedIn(userId);
      allow create, update: if signedIn(userId)
        && prefId == "app"
        && request.resource.data.keys().hasOnly(["theme", "updatedAt"])
        && request.resource.data.theme in ["system", "light", "dark"]
        && request.resource.data.updatedAt == request.time;
    }

    // The watchlist: one document so the list size can be capped here. Ids are checked again on read.
    match /users/{userId}/prefs/watchlist {
      allow create, update: if signedIn(userId)
        && request.resource.data.keys().hasOnly(["ids", "updatedAt"])
        && request.resource.data.ids is list
        && request.resource.data.ids.size() <= 50
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId}/explanations/{explanationId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          "symbol",
          "movePct",
          "summary",
          "inferenceSource",
          "buyerReasons",
          "sellerReasons",
          "whatWouldChange"
        ])
        && request.resource.data.symbol is string
        && request.resource.data.symbol.size() > 0
        && request.resource.data.symbol.size() < 16
        && request.resource.data.movePct is number
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() < 8000
        && request.resource.data.inferenceSource is string
        && request.resource.data.buyerReasons is list
        && request.resource.data.sellerReasons is list
        && request.resource.data.whatWouldChange is string
        && !request.resource.data.keys().hasAny(["notes", "watchlist"]);
    }

    // Stripe extension collections. Clients may start checkout. They cannot write a subscription.
    match /customers/{userId} {
      allow read: if signedIn(userId);
      allow write: if false;

      match /checkout_sessions/{sessionId} {
        allow read: if signedIn(userId);
        allow create: if signedIn(userId)
          && request.resource.data.keys().hasOnly(["price", "success_url", "cancel_url", "mode"])
          && request.resource.data.mode == "subscription"
          && request.resource.data.price is string
          && request.resource.data.price.size() > 0
          && request.resource.data.price.size() < 80
          && isHttpUrl(request.resource.data.success_url)
          && isHttpUrl(request.resource.data.cancel_url);
        allow update, delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if signedIn(userId);
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if signedIn(userId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }

  function signedIn(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function isUsageDay(dayId) {
    return dayId.matches('^\\d{4}-\\d{2}-\\d{2}$');
  }

  function isHttpUrl(value) {
    return value is string
      && value.size() > 8
      && value.size() < 500
      && (value.matches('^https://.*') || value.matches('^http://.*'));
  }
}
