# Optional overrides. Copy to .env.local.
# When these are unset, the app uses the public atlas-explain web config in
# src/platform/web/firebaseConfig.ts. Do not put service-account keys here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check → reCAPTCHA Enterprise site key (score-based, no checkbox).
# Do not add localhost to a key you will use in production.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only. Ignored when the app is built for production.
# `npm run dev` already sets self.FIREBASE_APPCHECK_DEBUG_TOKEN = true, which
# prints a token to register under App Check → Manage debug tokens.
# Paste a token you already registered, or set false to turn the debug provider off.
# Never ship a debug token in a production build.
VITE_APPCHECK_DEBUG_TOKEN=
