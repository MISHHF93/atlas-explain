# Copy to .env.local. Never commit real values.
# Firebase console → Project settings → Your apps → Web app config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check → reCAPTCHA Enterprise site key (score-based, no checkbox).
# Do not add localhost to a key you will use in production.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only. Ignored when the app is built for production.
# Set to true to print a debug token in the browser console, then register
# that token in Firebase console → App Check → Manage debug tokens.
# Or paste a token you already registered. Never ship this in production.
VITE_APPCHECK_DEBUG_TOKEN=
