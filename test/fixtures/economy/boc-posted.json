    "seriesDetail": {
        "V80691311": {
            "label": "Prime rate",
            "description": "Also called the prime lending rate, the interest rate that a financial institution uses as a base to determine interest rates for loan products. Each financial institution sets its own prime rate, as a function of its cost of funding, which, in turn, is influenced by the target for the overnight rate set by the Bank of Canada.",
            "dimension": {
                "key": "d",
                "name": "Date"
            },
            "dateFormat": "weekly",
            "metadata": {
                "unit": "Percent",
                "frequency": "Weekly"
            }
        },
        "V80691335": {
            "label": "Conventional mortgage, 5-year",
            "description": "The interest rate for a 5-year conventional mortgage offered by chartered banks in Canada.",
