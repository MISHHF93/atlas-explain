{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.DS_Store",
      "**/.git*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://apis.google.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://atlas-explain-mcp.atlas-explain.workers.dev wss://ws.kraken.com https://*.googleapis.com https://www.google.com https://www.gstatic.com/recaptcha/ https://apis.google.com; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://atlas-explain.firebaseapp.com; img-src 'self' data: https://www.gstatic.com https://coin-images.coingecko.com https://assets.coingecko.com https://img.logo.dev; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(app|signin|start|privacy|terms|partners|admin){,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/embed/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors https: http://localhost:*"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/admin",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/app",
        "destination": "/app.html"
      },
      {
        "source": "/app/**",
        "destination": "/app.html"
      },
      {
        "source": "/signin",
        "destination": "/app.html"
      },
      {
        "source": "/start",
        "destination": "/app.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/partners",
        "destination": "/partners.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ],
    "redirects": [
      {
        "source": "/how-it-works",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/demo/trading-terms.html",
        "destination": "/#setup",
        "type": 301
      },
      {
        "source": "/download/**",
        "destination": "/#setup",
        "type": 301
      },
      {
        "source": "/welcome",
        "destination": "/#setup",
        "type": 301
      },
      {
        "source": "/app/admin",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/connect",
        "destination": "/#setup",
        "type": 301
      },
      {
        "source": "/support",
        "destination": "/#questions",
        "type": 301
      },
      {
        "source": "/how-its-built",
        "destination": "/partners#how-its-built",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  }
}
